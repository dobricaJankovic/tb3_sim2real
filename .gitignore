# colcon
build/
install/
log/

# Source dependencies, fetched by scripts/workspace.sh from tb3_sim2real.repos.
# Imported, never vendored: a copy of turtlebot3_isaacsim in this tree would be
# a second source of truth for the Isaac Sim side.
src/

# python
__pycache__/
*.py[cod]
*.egg-info/

# large sim assets — keep scenes out of git until we decide on LFS
isaac/scenes/*.usd
isaac/scenes/*.usda
isaac/scenes/*.usdc
!isaac/scenes/.gitkeep

# turtlebot3_description copied out of the tb3_ros image so the isaacsim
# container can resolve the URDF's package:// mesh URLs. 40 MB of STL that
# already ships with ros-humble-turtlebot3-description — regenerate with the
# docker cp in isaac/scripts/import_tb3.py's docstring rather than committing.
isaac/scenes/turtlebot3_description/

# Generated Isaac Sim stages for the world registry. The manifest, the shared
# meshes and the generated .world ARE committed (text, reviewable, and the
# Gazebo backend then needs no build step); the USD is a binary-ish build
# product, so it is rebuilt with isaac/scripts/build_world_usd.py instead.
worlds/*/isaac/

# local env overrides
.env
docker-compose.override.yml

# editor
.vscode/
