<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Force Fast-DDS onto UDP and disable its shared-memory transport.

  WHY: the two containers run as different uids. NVIDIA's Isaac Sim image ends
  with `USER isaac-sim` (uid 1234); tb3_ros runs as root because it needs
  /dev/ttyACM0 and the lidar USB for the real robot. Fast-DDS creates its
  shared-memory segments under /dev/shm with mode 0700, so neither participant
  can open the other's segments even though `ipc: host` genuinely shares
  /dev/shm.

  The failure is silent and looks exactly like a working setup: discovery runs
  over UDP multicast, so `ros2 topic list` shows every Isaac Sim topic and
  `ros2 topic info --verbose` reports a healthy RELIABLE publisher — but the
  data path negotiates SHM and not one message is ever delivered. `ros2 topic
  echo` just hangs.

  Matching uids is the alternative fix, but Isaac Sim's image is built around
  uid 1234 and tb3_ros needs root, so neither side can move. UDP costs nothing
  at our data rates (a 360-point LaserScan at 5 Hz); revisit only if camera
  images are ever put on the wire.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_only</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="udp_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_only</transport_id>
        </userTransports>
        <!-- Without this, Fast-DDS re-adds its default SHM + UDP pair and the
             SHM locator comes back. -->
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
