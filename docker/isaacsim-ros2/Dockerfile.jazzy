# Isaac Sim 6.0 and ROS 2 Jazzy in a single Ubuntu 24.04 image.
#
# This is the pairing both projects target natively -- Isaac Sim ships on Ubuntu
# 24.04 and Jazzy is the distribution released for it -- so unlike the Humble
# image no part of it is off the beaten path.
#
# The two Python installations still have to be kept apart. Both are 3.12, but
# they are different installations with different site-packages and different
# linked libraries, and Isaac Sim's setup_python_env.sh appends to PYTHONPATH
# and LD_LIBRARY_PATH rather than replacing them, so a sourced ROS 2 environment
# would shadow Kit's own entries. The ros-isolate wrapper removes it.
#
#   docker build -f Dockerfile.jazzy -t isaacsim6-jazzy:latest .
#
#   docker run --rm -it --gpus all --network host --ipc host \
#       -e ACCEPT_EULA=Y -e PRIVACY_CONSENT=Y \
#       isaacsim6-jazzy:latest
#
# Then, inside the container, `isaacsim` for the simulator and the usual ros2
# tooling for everything else.

# The NGC release, for the same provenance reason as Dockerfile.humble.
# Noble tolerates a locally built tree where jammy does not, which is
# exactly why the Humble image caught this and this one never would.
ARG ISAACSIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.1
ARG BASE_IMAGE=ros:jazzy-ros-base

FROM ${ISAACSIM_IMAGE} AS isaacsim

FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Isaac Sim 6.0 + ROS 2 Jazzy"
LABEL org.opencontainers.image.description="NVIDIA Isaac Sim 6.0 and ROS 2 Jazzy in one Ubuntu 24.04 image."
LABEL org.opencontainers.image.base.name="docker.io/library/ros:jazzy-ros-base"

ENV DEBIAN_FRONTEND=noninteractive

# --- ROS 2 ------------------------------------------------------------------
# Desktop for RViz and the standard message packages, Nav2 as the navigation
# stack, and Gazebo Harmonic, the pairing named by REP-2000. Gazebo Classic
# reached end of life in January 2025 and was never released for Jazzy, so
# unlike the Humble image there is only one simulator to install.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-desktop \
        ros-${ROS_DISTRO}-navigation2 \
        ros-${ROS_DISTRO}-nav2-bringup \
        ros-${ROS_DISTRO}-ros-gz \
        ros-${ROS_DISTRO}-gz-ros2-control \
        ros-${ROS_DISTRO}-xacro \
        ros-${ROS_DISTRO}-tf2-tools \
        ros-${ROS_DISTRO}-pointcloud-to-laserscan \
        python3-colcon-common-extensions \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# --- Isaac Sim runtime dependencies -----------------------------------------
# The set installed by NVIDIA's own Dockerfile, plus the Vulkan loader, which
# their base image already provides and Ubuntu's does not.
RUN touch /etc/ld.so.nohwcap \
    && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gpgv \
        libatomic1 \
        libegl1 \
        libgl1 \
        libglu1-mesa \
        libglvnd0 \
        libglx0 \
        libgomp1 \
        libnghttp2-14 \
        libsm6 \
        libvulkan1 \
        libxi6 \
        libxrandr2 \
        libxt6 \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# --- GPU driver discovery ---------------------------------------------------
# Reproduced from NVIDIA's Isaac Sim Dockerfile. These tell the GLVND and Vulkan
# loaders where the driver injected by the NVIDIA container runtime lives; they
# are not display or X11 configuration.
RUN mkdir -p /usr/share/glvnd/egl_vendor.d /etc/vulkan/icd.d /etc/vulkan/implicit_layer.d \
    && printf '{\n    "file_format_version" : "1.0.0",\n    "ICD" : {\n        "library_path" : "libEGL_nvidia.so.0"\n    }\n}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json \
    && printf '{\n    "file_format_version" : "1.0.0",\n    "ICD" : {\n        "library_path" : "libEGL_mesa.so.0"\n    }\n}\n' \
        > /usr/share/glvnd/egl_vendor.d/50_mesa.json \
    && printf '{\n    "file_format_version" : "1.0.0",\n    "ICD" : {\n        "library_path" : "libGLX_nvidia.so.0",\n        "api_version" : "1.3.194"\n    }\n}\n' \
        > /etc/vulkan/icd.d/nvidia_icd.json \
    && printf '{\n    "file_format_version" : "1.0.0",\n    "layer": {\n        "name": "VK_LAYER_NV_optimus",\n        "type": "INSTANCE",\n        "library_path": "libGLX_nvidia.so.0",\n        "api_version" : "1.3.194",\n        "implementation_version" : "1",\n        "description" : "NVIDIA Optimus layer",\n        "functions": {\n            "vkGetInstanceProcAddr": "vk_optimusGetInstanceProcAddr",\n            "vkGetDeviceProcAddr": "vk_optimusGetDeviceProcAddr"\n        },\n        "enable_environment": {\n            "__NV_PRIME_RENDER_OFFLOAD": "1"\n        },\n        "disable_environment": {\n            "DISABLE_LAYER_NV_OPTIMUS_1": ""\n        }\n    }\n}\n' \
        > /etc/vulkan/implicit_layer.d/nvidia_layers.json

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json
ENV MIN_DRIVER_VERSION=570.169

# --- Isaac Sim --------------------------------------------------------------
# Isaac Sim is a self-contained tree: its own interpreter, its own libraries and
# its own build of the ROS 2 client libraries for both Humble and Jazzy. Unlike
# NVIDIA's image this one runs as root, matching the ROS 2 images and letting
# both stacks share Fast DDS shared memory segments.
COPY --from=isaacsim --chown=root:root /isaac-sim /isaac-sim

ENV ISAACSIM_PATH=/isaac-sim
ENV ISAACSIM_ROS_DISTRO=jazzy

# ros-isolate removes the system ROS 2 installation from the environment before
# handing over to Kit; see the comments in the script for why that is needed.
COPY ros-isolate /usr/local/bin/ros-isolate
RUN chmod 0755 /usr/local/bin/ros-isolate \
    && printf '#!/bin/sh\nexec ros-isolate "%s/isaac-sim.sh" "$@"\n' "${ISAACSIM_PATH}" \
        > /usr/local/bin/isaacsim \
    && printf '#!/bin/sh\nexec ros-isolate "%s/python.sh" "$@"\n' "${ISAACSIM_PATH}" \
        > /usr/local/bin/isaacsim-python \
    && printf '#!/bin/sh\nexec ros-isolate "%s/runheadless.sh" "$@"\n' "${ISAACSIM_PATH}" \
        > /usr/local/bin/isaacsim-headless \
    && chmod 0755 /usr/local/bin/isaacsim /usr/local/bin/isaacsim-python /usr/local/bin/isaacsim-headless

WORKDIR /isaac-sim

# ENTRYPOINT and CMD are inherited from the ROS 2 base image: ros_entrypoint.sh
# sources the distribution and execs the command, so `ros2` works out of the box
# and `isaacsim` still gets a clean environment.
