<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_bringup</name>
  <version>0.0.1</version>
  <description>
    Single entry point for bringing up a TurtleBot3 against one of three backends:
    the real robot, Gazebo Classic, or Isaac Sim. Nav2 and robot_state_publisher
    are identical in all three cases; only the backend layer swaps.
  </description>
  <maintainer email="jd220010d@student.etf.bg.ac.rs">MihStev</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- tb3_bringup/worlds.py parses the world registry's world.yaml manifests -->
  <exec_depend>python3-yaml</exec_depend>

  <!-- shared across all backends -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- gazebo backend -->
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <!-- real backend -->
  <exec_depend>turtlebot3_node</exec_depend>
  <exec_depend>ld08_driver</exec_depend>

  <!-- isaacsim backend (only if we publish PointCloud2 instead of LaserScan) -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
