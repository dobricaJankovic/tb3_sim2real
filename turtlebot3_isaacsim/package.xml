<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot3_isaacsim</name>
  <version>0.1.0</version>
  <description>
    Isaac Sim simulation package for the TurtleBot3.

    The Isaac Sim counterpart of turtlebot3_gazebo: one `ros2 launch` starts the
    simulator, spawns the robot and brings up robot_state_publisher, presenting
    the same ROS 2 interface the real robot does. Every consumer package —
    turtlebot3_navigation2, turtlebot3_cartographer, turtlebot3_teleop — runs
    unchanged apart from use_sim_time:=true.
  </description>

  <maintainer email="jd220010d@student.etf.bg.ac.rs">dobricaJankovic</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Starts Kit from a launch file. NVIDIA's own package, vendored unmodified;
       it is to this package what gazebo_ros is to turtlebot3_gazebo.
       https://github.com/isaac-sim/IsaacSim-ros_workspaces -->
  <exec_depend>isaacsim_bringup</exec_depend>

  <!-- The kinematic tree. Deliberately NOT duplicated into this package the way
       turtlebot3_gazebo duplicates it: that copy exists only to repoint meshes
       for Gazebo's model:// resolution, and Isaac Sim resolves meshes once at
       URDF-import time into a self-contained USD. See models/README.md. -->
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
