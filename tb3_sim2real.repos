# Source dependencies, imported with vcstool:
#
#   scripts/workspace.sh          # vcs import + colcon ignores, idempotent
#
# Neither of these is on apt, and neither is vendored into this repository —
# that is the point. turtlebot3_isaacsim is developed as a peer of
# turtlebot3_gazebo in its own repository and imported here; a copy in this tree
# would be a second source of truth for the Isaac Sim side, which is exactly the
# thing this repository exists to prevent.
repositories:
  turtlebot3_isaacsim:
    type: git
    url: git@github.com:dobrica-jankovic/turtlebot3_isaacsim.git
    version: fix-map-mirroring-add-small-worlds

  # NVIDIA ships isaacsim_bringup as source only, inside a repository that also
  # holds eight other example packages, twice over (humble_ws and jazzy_ws).
  # scripts/workspace.sh drops a COLCON_IGNORE in every one except our distro's
  # isaacsim_bringup, which is the only thing we use: turtlebot3_isaacsim
  # includes its run_isaacsim.launch.xml to put Kit behind a `ros2 launch`.
  #
  # Pinned to the tag that matches the installed Isaac Sim, 6.1.0. This was
  # 6.0.1 until 2026-09-15, because the 6.1.0 tag migrated every repo-owned
  # launch file from Python to XML -- run_isaacsim.launch.py became
  # run_isaacsim.launch.xml -- and turtlebot3_isaacsim still included the old
  # name with a PythonLaunchDescriptionSource, which dies with a bare ENOENT.
  # That is now fixed at the source, in turtlebot3_isaacsim, with
  # AnyLaunchDescriptionSource and the new filename, so the two versions agree.
  IsaacSim-ros_workspaces:
    type: git
    url: https://github.com/isaac-sim/IsaacSim-ros_workspaces.git
    version: IsaacSim-6.1.0
