# Source dependencies, imported with vcstool:
#
#   scripts/workspace.sh          # vcs import + colcon ignores, idempotent
#
# Neither of these is on apt, and neither is vendored into this repository —
# that is the point. turtlebot3_isaacsim is developed as a peer of
# turtlebot3_gazebo in its own repository and imported here; a copy in this tree
# would be a second source of truth for the Isaac Sim side, which is exactly the
# thing this repository exists to prevent.
repositories:
  turtlebot3_isaacsim:
    type: git
    url: git@github.com:dobrica-jankovic/turtlebot3_isaacsim.git
    version: fix-map-mirroring-add-small-worlds

  # NVIDIA ships isaacsim_bringup as source only, inside a repository that also
  # holds eight other example packages, twice over (humble_ws and jazzy_ws).
  # scripts/workspace.sh drops a COLCON_IGNORE in every one except our distro's
  # isaacsim_bringup, which is the only thing we use: turtlebot3_isaacsim
  # includes its run_isaacsim.launch.py to put Kit behind a `ros2 launch`.
  #
  # PINNED TO 6.0.1 DELIBERATELY, while Isaac Sim itself is 6.1.0.
  #
  # The IsaacSim-6.1.0 tag reimplements run_isaacsim.launch.py as
  # run_isaacsim.launch.xml -- argument for argument the same file, but a
  # different name and a different source type, so a PythonLaunchDescriptionSource
  # pointed at the old name dies with a bare ENOENT. turtlebot3_isaacsim
  # includes it by that name and was verified against this revision.
  #
  # The mismatch is not a runtime one: turtlebot3_isaacsim passes
  # install_path=/isaac-sim explicitly, and install_path overrides the launcher's
  # own `version` default, so the 6.0.1 launcher starts the 6.1.0 install that
  # is actually on disk. That is the combination its README records as run
  # against a GPU.
  #
  # Moving to the 6.1.0 tag is a two-line change in turtlebot3_isaacsim --
  # AnyLaunchDescriptionSource and the new filename -- and belongs in that
  # repository, not in a patch applied from here.
  IsaacSim-ros_workspaces:
    type: git
    url: https://github.com/isaac-sim/IsaacSim-ros_workspaces.git
    version: IsaacSim-6.0.1
